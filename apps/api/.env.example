# Copy to apps/api/.env (gitignored) and fill in. Never put a real key in this file.

# Google AI Studio key (server-side only, never expose to the frontend). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pin the model for the demo. Leave empty to auto-pick the newest available Flash model.
GEMINI_MODEL=

# Milliseconds before a Gemini call is abandoned (reasoning effort is set to low automatically)
GEMINI_TIMEOUT_MS=100000

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000

# Dev only: 1 = recorded fixture responses (labelled provider "fixture"), NOT live inference
VRE_FIXTURE_MODE=0

# Physical Lab vision provider: auto = Gemini first, local LM Studio when Gemini's free quota runs out | gemini | lmstudio
VISION_PROVIDER=auto
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b

# Analysis cache folder (default apps/api/.cache/analyses; "off" disables) and max simultaneous model calls
VRE_CACHE_DIR=
VRE_MAX_CONCURRENT_CALLS=2
