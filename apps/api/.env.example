# Copy to apps/api/.env (gitignored) and fill in. Never put a real key in this file.

# Google AI Studio key (server-side only, never expose to the frontend)
GEMINI_API_KEY=

# Pin the model for the demo. Leave empty to auto-pick the newest available Flash model.
GEMINI_MODEL=

# Reasoning effort: low = fastest (default), medium/high = slower. Empty = model default.
GEMINI_THINKING_LEVEL=low

# Seconds before a model call is abandoned
GEMINI_TIMEOUT_S=90

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dev only: 1 = recorded fixture responses (labelled provider "fixture"), NOT live inference
VRE_FIXTURE_MODE=0
