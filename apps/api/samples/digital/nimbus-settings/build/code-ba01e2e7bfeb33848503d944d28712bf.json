{"target": "html", "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Nimbus - Settings</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-[#f8fafc] text-[#0f172a] font-sans antialiased h-screen flex overflow-hidden\">\n\n  <!-- Sidebar -->\n  <aside class=\"w-[230px] bg-[#0b1329] text-slate-400 flex flex-col justify-between select-none shrink-0\">\n    <div>\n      <!-- Logo -->\n      <div class=\"px-6 py-6 flex items-center gap-3\">\n        <div class=\"w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-500 to-indigo-400 flex items-center justify-center text-white shadow-md\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z\"></path></svg>\n        </div>\n        <span class=\"text-white font-semibold text-lg tracking-tight\">Nimbus</span>\n      </div>\n\n      <!-- Navigation Menu -->\n      <nav class=\"px-3 space-y-1 mt-2\">\n        <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg>\n          Dashboard\n        </a>\n        <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z\"/></svg>\n          Projects\n        </a>\n        <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4\"/></svg>\n          My tasks\n        </a>\n        <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"/></svg>\n          Reports\n        </a>\n        <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z\"/></svg>\n          Team\n        </a>\n      </nav>\n    </div>\n\n    <!-- Bottom Sidebar (Settings & Logout) -->\n    <div class=\"px-3 pb-6 space-y-1\">\n      <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium bg-white/10 text-white transition-colors\">\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n        Settings\n      </a>\n      <a href=\"#\" class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm font-medium hover:bg-white/5 hover:text-white transition-colors\">\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n        Log out\n      </a>\n    </div>\n  </aside>\n\n  <!-- Main Content Wrapper -->\n  <div class=\"flex-1 flex flex-col min-w-0 overflow-y-auto\">\n\n    <!-- Top Header -->\n    <header class=\"h-16 border-b border-slate-200 bg-white px-8 flex items-center justify-between shrink-0\">\n      <div class=\"relative w-96\">\n        <span class=\"absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/></svg>\n        </span>\n        <input type=\"text\" placeholder=\"Search projects and tasks...\" class=\"w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all text-slate-700 placeholder:text-slate-400\">\n      </div>\n      <div class=\"flex items-center gap-4\">\n        <button class=\"w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-500 hover:bg-slate-50 transition-colors\">\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\"/></svg>\n        </button>\n        <div class=\"w-9 h-9 rounded-full bg-amber-400 text-amber-950 font-semibold text-sm flex items-center justify-center ring-2 ring-amber-400/20 shadow-sm cursor-pointer\">\n          AK\n        </div>\n      </div>\n    </header>\n\n    <!-- Page Content -->\n    <main class=\"flex-1 p-8 max-w-[1100px]\">\n      <!-- Page Title -->\n      <div class=\"mb-6\">\n        <h1 class=\"text-2xl font-bold text-slate-900 tracking-tight\">Settings</h1>\n        <p class=\"text-sm text-slate-500 mt-0.5\">Manage your profile and how Nimbus notifies you.</p>\n      </div>\n\n      <!-- Navigation Tabs -->\n      <div class=\"border-b border-slate-200 mb-6 flex gap-8\">\n        <button class=\"pb-3 text-sm font-medium text-indigo-600 border-b-2 border-indigo-600 transition-colors\">Profile</button>\n        <button class=\"pb-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors\">Notifications</button>\n        <button class=\"pb-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors\">Billing</button>\n        <button class=\"pb-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors\">Integrations</button>\n      </div>\n\n      <!-- Card container -->\n      <div class=\"bg-white border border-slate-200/80 rounded-xl shadow-sm p-7\">\n        <div class=\"mb-6\">\n          <h2 class=\"text-base font-semibold text-slate-900\">Profile</h2>\n          <p class=\"text-sm text-slate-500\">This is how teammates see you on boards and comments.</p>\n        </div>\n\n        <form class=\"space-y-6\">\n          <!-- Full Name & Work Email Inputs -->\n          <div class=\"grid grid-cols-2 gap-5\">\n            <div>\n              <label class=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">Full name</label>\n              <input type=\"text\" value=\"Asha Kapoor\" class=\"w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all\">\n            </div>\n            <div>\n              <label class=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2\">Work email</label>\n              <input type=\"email\" value=\"asha@fernway.io\" class=\"w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all\">\n            </div>\n          </div>\n\n          <hr class=\"border-slate-100\">\n\n          <!-- Toggle 1 -->\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <div class=\"text-sm font-medium text-slate-900\">Email me about due dates</div>\n              <div class=\"text-sm text-slate-500\">A daily digest of tasks due in the next 48 hours</div>\n            </div>\n            <label class=\"relative inline-flex items-center cursor-pointer\">\n              <input type=\"checkbox\" checked class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <!-- Toggle 2 -->\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <div class=\"text-sm font-medium text-slate-900\">Weekly sprint report</div>\n              <div class=\"text-sm text-slate-500\">Sent every Monday at 9:00</div>\n            </div>\n            <label class=\"relative inline-flex items-center cursor-pointer\">\n              <input type=\"checkbox\" class=\"sr-only peer\">\n              <div class=\"w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600\"></div>\n            </label>\n          </div>\n\n          <hr class=\"border-slate-100\">\n\n          <!-- Footer Buttons -->\n          <div class=\"flex items-center justify-end gap-3 pt-1\">\n            <button type=\"button\" class=\"px-4 py-2.5 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors\">Cancel</button>\n            <button type=\"submit\" class=\"px-4 py-2.5 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 shadow-sm shadow-indigo-500/20 transition-colors\">Save changes</button>\n          </div>\n        </form>\n      </div>\n    </main>\n  </div>\n\n</body>\n</html>", "notes": ["Used a single self-contained HTML file with Tailwind CDN.", "Meticulously matched all text contents, input values, and color palettes.", "Added working toggle checkbox components matching visual states."], "source": "ai", "provider": {"name": "google-gemini", "model": "gemini-3.5-flash-lite"}, "change": null, "size": {"width": 1280, "height": 800}}