{"target": "html", "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nimbus Dashboard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-[#f8fafc] text-[#0f172a] h-screen w-screen overflow-hidden flex\">\n\n    <!-- Sidebar -->\n    <aside class=\"w-[230px] bg-[#0b132b] flex flex-col justify-between py-6 px-4 select-none flex-shrink-0\">\n        <div>\n            <!-- Logo -->\n            <div class=\"flex items-center gap-3 px-3 mb-8\">\n                <div class=\"w-8 h-8 rounded-lg bg-gradient-to-tr from-[#3b82f6] to-[#60a5fa] flex items-center justify-center text-white shadow-md\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 10V3L4 14h7v7l9-11h-7z\"/></svg>\n                </div>\n                <span class=\"text-white font-bold text-lg tracking-wide\">Nimbus</span>\n            </div>\n\n            <!-- Navigation -->\n            <nav class=\"space-y-1\">\n                <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#1e293b] text-white font-medium text-sm transition\">\n                    <svg class=\"w-4 h-4 text-slate-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\"/></svg>\n                    Dashboard\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z\"/></svg>\n                    Projects\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4\"/></svg>\n                    My tasks\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"/></svg>\n                    Reports\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z\"/></svg>\n                    Team\n                </a>\n            </nav>\n        </div>\n\n        <!-- Footer Links -->\n        <div class=\"space-y-1\">\n            <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n                Settings\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-[#1e293b]/50 font-medium text-sm transition\">\n                <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1\"/></svg>\n                Log out\n            </a>\n        </div>\n    </aside>\n\n    <!-- Main Content Area -->\n    <div class=\"flex-1 flex flex-col min-w-0 overflow-y-auto\">\n        \n        <!-- Header -->\n        <header class=\"h-16 border-b border-slate-200 bg-white px-8 flex items-center justify-between flex-shrink-0\">\n            <div class=\"relative w-96\">\n                <span class=\"absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/></svg>\n                </span>\n                <input type=\"text\" placeholder=\"Search projects and tasks...\" class=\"w-full bg-[#f1f5f9] text-sm text-slate-800 pl-10 pr-4 py-2 rounded-lg border-none focus:outline-none focus:ring-1 focus:ring-slate-300\">\n            </div>\n            \n            <div class=\"flex items-center gap-4\">\n                <button class=\"w-9 h-9 rounded-full border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-50 transition\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\"/></svg>\n                </button>\n                <div class=\"w-9 h-9 rounded-full bg-[#fbbf24] text-amber-950 font-semibold text-xs flex items-center justify-center shadow-sm\">\n                    AK\n                </div>\n            </div>\n        </header>\n\n        <!-- Main Body -->\n        <main class=\"p-8 max-w-[1280px] w-full mx-auto\">\n            \n            <!-- Title & Action -->\n            <div class=\"flex items-start justify-between mb-8\">\n                <div>\n                    <h1 class=\"text-2xl font-bold text-slate-900 tracking-tight\">Dashboard</h1>\n                    <p class=\"text-sm text-slate-500 mt-1\">Good morning, Asha. Here is your team this week.</p>\n                </div>\n                <button class=\"bg-[#6366f1] hover:bg-[#5855eb] text-white text-sm font-medium px-4 py-2.5 rounded-lg shadow-sm transition flex items-center gap-2\">\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4v16m8-8H4\"/></svg>\n                    + New project\n                </button>\n            </div>\n\n            <!-- Stats Grid -->\n            <div class=\"grid grid-cols-4 gap-5 mb-8\">\n                <!-- Card 1 -->\n                <div class=\"bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm\">\n                    <div class=\"text-xs font-medium text-slate-500\">Active projects</div>\n                    <div class=\"text-3xl font-bold text-slate-900 mt-2\">12</div>\n                    <div class=\"text-xs font-medium text-emerald-600 mt-2\">+2 this month</div>\n                </div>\n                <!-- Card 2 -->\n                <div class=\"bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm\">\n                    <div class=\"text-xs font-medium text-slate-500\">Tasks due this week</div>\n                    <div class=\"text-3xl font-bold text-slate-900 mt-2\">38</div>\n                    <div class=\"text-xs font-medium text-emerald-600 mt-2\">9 due today</div>\n                </div>\n                <!-- Card 3 -->\n                <div class=\"bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm\">\n                    <div class=\"text-xs font-medium text-slate-500\">Completed</div>\n                    <div class=\"text-3xl font-bold text-slate-900 mt-2\">214</div>\n                    <div class=\"text-xs font-medium text-emerald-600 mt-2\">+18% vs last week</div>\n                </div>\n                <!-- Card 4 -->\n                <div class=\"bg-white p-5 rounded-xl border border-slate-200/80 shadow-sm\">\n                    <div class=\"text-xs font-medium text-slate-500\">Team members</div>\n                    <div class=\"text-3xl font-bold text-slate-900 mt-2\">9</div>\n                    <div class=\"text-xs font-medium text-emerald-600 mt-2\">2 invited</div>\n                </div>\n            </div>\n\n            <!-- Recent Projects Table -->\n            <div class=\"bg-white rounded-xl border border-slate-200/80 shadow-sm overflow-hidden\">\n                <div class=\"px-6 py-4 flex items-center justify-between border-b border-slate-100\">\n                    <h2 class=\"font-semibold text-slate-900 text-sm\">Recent projects</h2>\n                    <a href=\"#\" class=\"text-xs font-medium text-[#6366f1] hover:underline\">View all</a>\n                </div>\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"text-[11px] font-semibold text-slate-400 uppercase tracking-wider border-b border-slate-100 bg-slate-50/50\">\n                            <th class=\"py-3 px-6\">Project</th>\n                            <th class=\"py-3 px-6\">Owner</th>\n                            <th class=\"py-3 px-6\">Progress</th>\n                            <th class=\"py-3 px-6\">Status</th>\n                            <th class=\"py-3 px-6\">Due</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-slate-100 text-sm\">\n                        <!-- Row 1 -->\n                        <tr class=\"hover:bg-slate-50/50 transition\">\n                            <td class=\"py-4 px-6 font-medium text-slate-900\">Website relaunch</td>\n                            <td class=\"py-4 px-6 text-slate-600\">Asha K.</td>\n                            <td class=\"py-4 px-6 w-48\">\n                                <div class=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                                    <div class=\"bg-[#818cf8] h-full rounded-full\" style=\"width: 65%\"></div>\n                                </div>\n                            </td>\n                            <td class=\"py-4 px-6\">\n                                <span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700\">\n                                    On track\n                                </span>\n                            </td>\n                            <td class=\"py-4 px-6 text-slate-600\">18 Oct</td>\n                        </tr>\n                        <!-- Row 2 -->\n                        <tr class=\"hover:bg-slate-50/50 transition\">\n                            <td class=\"py-4 px-6 font-medium text-slate-900\">Mobile app v2</td>\n                            <td class=\"py-4 px-6 text-slate-600\">Rohan M.</td>\n                            <td class=\"py-4 px-6 w-48\">\n                                <div class=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                                    <div class=\"bg-[#818cf8] h-full rounded-full\" style=\"width: 35%\"></div>\n                                </div>\n                            </td>\n                            <td class=\"py-4 px-6\">\n                                <span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700\">\n                                    At risk\n                                </span>\n                            </td>\n                            <td class=\"py-4 px-6 text-slate-600\">2 Nov</td>\n                        </tr>\n                        <!-- Row 3 -->\n                        <tr class=\"hover:bg-slate-50/50 transition\">\n                            <td class=\"py-4 px-6 font-medium text-slate-900\">Billing migration</td>\n                            <td class=\"py-4 px-6 text-slate-600\">Leah T.</td>\n                            <td class=\"py-4 px-6 w-48\">\n                                <div class=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                                    <div class=\"bg-[#818cf8] h-full rounded-full\" style=\"width: 15%\"></div>\n                                </div>\n                            </td>\n                            <td class=\"py-4 px-6\">\n                                <span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-50 text-rose-700\">\n                                    Blocked\n                                </span>\n                            </td>\n                            <td class=\"py-4 px-6 text-slate-600\">25 Oct</td>\n                        </tr>\n                        <!-- Row 4 -->\n                        <tr class=\"hover:bg-slate-50/50 transition\">\n                            <td class=\"py-4 px-6 font-medium text-slate-900\">Onboarding emails</td>\n                            <td class=\"py-4 px-6 text-slate-600\">Asha K.</td>\n                            <td class=\"py-4 px-6 w-48\">\n                                <div class=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                                    <div class=\"bg-[#818cf8] h-full rounded-full\" style=\"width: 90%\"></div>\n                                </div>\n                            </td>\n                            <td class=\"py-4 px-6\">\n                                <span class=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700\">\n                                    On track\n                                </span>\n                            </td>\n                            <td class=\"py-4 px-6 text-slate-600\">14 Oct</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n\n        </main>\n    </div>\n\n</body>\n</html>", "notes": ["Used Inter font from Google Fonts to precisely match typography.", "Built exact sidebar layout with active state styling on the Dashboard item.", "Recreated metric summary cards and the table with custom progress bars and status pills."], "source": "ai", "provider": {"name": "google-gemini", "model": "gemini-3.5-flash-lite"}, "change": null, "size": {"width": 1280, "height": 800}}