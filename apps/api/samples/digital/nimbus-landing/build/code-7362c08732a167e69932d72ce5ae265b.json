{"target": "html", "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Nimbus - Plan projects your team actually finishes</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-white text-slate-900 font-sans antialiased selection:bg-indigo-500 selection:text-white\">\n  \n  <div class=\"max-w-[1280px] mx-auto min-h-screen flex flex-col justify-between\">\n    \n    <!-- Navbar -->\n    <header class=\"flex items-center justify-between px-12 py-6\">\n      <div class=\"flex items-center gap-10\">\n        <!-- Logo -->\n        <a href=\"#\" class=\"flex items-center gap-2.5\">\n          <div class=\"w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center shadow-md shadow-blue-500/20\">\n            <div class=\"w-3.5 h-3.5 rounded-sm bg-white/90\"></div>\n          </div>\n          <span class=\"text-xl font-bold tracking-tight text-slate-900\">Nimbus</span>\n        </a>\n\n        <!-- Navigation Links -->\n        <nav class=\"hidden md:flex items-center gap-8 text-[15px] font-medium text-slate-600\">\n          <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Features</a>\n          <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Pricing</a>\n          <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Customers</a>\n          <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Docs</a>\n        </nav>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex items-center gap-4\">\n        <a href=\"#\" class=\"text-[15px] font-medium text-slate-700 hover:text-slate-900 px-4 py-2 transition-colors\">Log in</a>\n        <a href=\"#\" class=\"text-[15px] font-medium bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl shadow-sm transition-colors\">Start free trial</a>\n      </div>\n    </header>\n\n    <!-- Main Content -->\n    <main class=\"px-12 py-8\">\n      \n      <!-- Hero Section -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        <!-- Hero Text -->\n        <div class=\"lg:col-span-6 space-y-6\">\n          <div class=\"inline-flex items-center gap-2 bg-indigo-50 text-indigo-700 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide\">\n            <span class=\"w-2 h-2 rounded-full bg-indigo-600\"></span>\n            New \u00b7 Sprint reports\n          </div>\n          \n          <h1 class=\"text-5xl lg:text-[56px] font-extrabold text-slate-900 tracking-tight leading-[1.1]\">\n            Plan projects your team actually finishes.\n          </h1>\n          \n          <p class=\"text-lg text-slate-600 leading-relaxed max-w-xl\">\n            Nimbus keeps tasks, deadlines and progress in one shared board, so nothing slips between meetings.\n          </p>\n          \n          <div class=\"flex items-center gap-4 pt-2\">\n            <a href=\"#\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-7 py-3.5 rounded-xl shadow-lg shadow-indigo-600/20 transition-all text-base\">\n              Start free trial\n            </a>\n            <a href=\"#\" class=\"bg-white hover:bg-slate-50 text-slate-800 font-medium px-7 py-3.5 rounded-xl border border-slate-200 transition-all text-base\">\n              Book a demo\n            </a>\n          </div>\n        </div>\n\n        <!-- Hero Graphic (Kanban Preview) -->\n        <div class=\"lg:col-span-6\">\n          <div class=\"bg-white p-5 rounded-3xl border border-slate-100 shadow-[0_20px_50px_rgba(8,112,184,0.07)] relative\">\n            \n            <div class=\"grid grid-cols-3 gap-4\">\n              \n              <!-- TO DO Column -->\n              <div class=\"bg-slate-50/80 p-3.5 rounded-2xl flex flex-col gap-3\">\n                <div class=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider px-1\">To do</div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-indigo-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-3/4 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/2\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-indigo-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-5/6 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-2/3\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-indigo-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-2/3 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/3\"></div>\n                </div>\n              </div>\n\n              <!-- IN PROGRESS Column -->\n              <div class=\"bg-slate-50/80 p-3.5 rounded-2xl flex flex-col gap-3\">\n                <div class=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider px-1\">In progress</div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-amber-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-4/5 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/2\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-amber-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-2/3 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-3/4\"></div>\n                </div>\n                <div class=\"h-24\"></div>\n              </div>\n\n              <!-- DONE Column -->\n              <div class=\"bg-slate-50/80 p-3.5 rounded-2xl flex flex-col gap-3\">\n                <div class=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider px-1\">Done</div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-5/6 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/3\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-3/4 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/2\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-2/3 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-2/3\"></div>\n                </div>\n                <div class=\"bg-white p-3 rounded-xl border border-slate-100 shadow-sm relative overflow-hidden\">\n                  <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500\"></div>\n                  <div class=\"h-2.5 bg-slate-100 rounded-full w-4/5 mb-2\"></div>\n                  <div class=\"h-2 bg-slate-50 rounded-full w-1/4\"></div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Feature Cards Grid -->\n      <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mt-20\">\n        \n        <!-- Card 1 -->\n        <div class=\"bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center mb-6\">\n              <div class=\"w-5 h-5 rounded-md bg-indigo-600/20\"></div>\n            </div>\n            <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Shared boards</h3>\n            <p class=\"text-slate-600 text-[15px] leading-relaxed\">\n              Drag tasks across stages and see who owns what.\n            </p>\n          </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center mb-6\">\n              <div class=\"w-5 h-5 rounded-md bg-indigo-600/20\"></div>\n            </div>\n            <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Deadline alerts</h3>\n            <p class=\"text-slate-600 text-[15px] leading-relaxed\">\n              Get nudged before a due date, not after it.\n            </p>\n          </div>\n        </div>\n\n        <!-- Card 3 -->\n        <div class=\"bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between\">\n          <div>\n            <div class=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center mb-6\">\n              <div class=\"w-5 h-5 rounded-md bg-indigo-600/20\"></div>\n            </div>\n            <h3 class=\"text-lg font-bold text-slate-900 mb-2\">Sprint reports</h3>\n            <p class=\"text-slate-600 text-[15px] leading-relaxed\">\n              Weekly progress charts your manager can read.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"px-12 py-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-sm text-slate-500\">\n      <p>\u00a9 2026 Nimbus Labs</p>\n      <div class=\"flex items-center gap-6 mt-4 sm:mt-0\">\n        <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Privacy</a>\n        <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Terms</a>\n        <a href=\"#\" class=\"hover:text-slate-900 transition-colors\">Contact</a>\n      </div>\n    </footer>\n\n  </div>\n\n</body>\n</html>", "notes": ["Built as a single responsive HTML page using Tailwind CSS via CDN.", "Recreated the exact Kanban board preview illustration with clean structural divs and status color bars.", "Used pure inline CSS/Tailwind shapes for the card icons.", "All typography, spacing, and button text match the reference layout precisely."], "source": "ai", "provider": {"name": "google-gemini", "model": "gemini-3.5-flash-lite"}, "change": null, "size": {"width": 1280, "height": 800}}