{"target": "html", "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=1536, initial-scale=1.0\">\n  <title>Banana Hacks</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n    body {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      background-color: #faf5e6;\n      color: #1a1a15;\n      margin: 0;\n      padding: 0;\n      width: 1536px;\n      height: 674px;\n      overflow: hidden;\n    }\n    .font-mono-code {\n      font-family: 'Space Mono', monospace;\n    }\n    .bg-grid {\n      background-size: 26px 26px;\n      background-image: \n        linear-gradient(to right, rgba(210, 202, 175, 0.45) 1px, transparent 1px),\n        linear-gradient(to bottom, rgba(210, 202, 175, 0.45) 1px, transparent 1px);\n    }\n    .shadow-hard-sm {\n      box-shadow: 1.5px 1.5px 0px #1a1a15;\n    }\n    .shadow-hard-md {\n      box-shadow: 2.5px 2.5px 0px #1a1a15;\n    }\n    .shadow-hard-lg {\n      box-shadow: 3.5px 3.5px 0px #1a1a15;\n    }\n  </style>\n</head>\n<body class=\"bg-grid relative select-none\">\n\n  <!-- Top Navigation Bar [x 0, y 0, w 1536, h 35] -->\n  <header class=\"absolute top-0 left-0 w-[1536px] h-[35px] border-b border-[#1a1a15] bg-[#faf5e6] flex items-center justify-between px-[18px] z-30\">\n    <div class=\"flex items-center space-x-6\">\n      <!-- Banana Hacks Logo -->\n      <a href=\"#\" class=\"flex items-center space-x-2 text-[#1a1a15]\">\n        <!-- Banana Arc Icon -->\n        <svg class=\"w-[14px] h-[14px] text-[#1a1a15] fill-none stroke-current\" stroke-width=\"2.2\" stroke-lineca