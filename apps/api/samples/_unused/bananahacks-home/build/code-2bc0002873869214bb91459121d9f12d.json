x=\"106\" cy=\"108\" r=\"45\" fill=\"none\" stroke=\"#684f18\" stroke-width=\"1\" stroke-opacity=\"0.3\"/>\n\n        <!-- Eyes -->\n        <circle cx=\"98\" cy=\"102\" r=\"3.8\" fill=\"#1a1a15\" />\n        <circle cx=\"96.8\" cy=\"100.8\" r=\"1.2\" fill=\"#ffffff\" />\n        <circle cx=\"118\" cy=\"98.5\" r=\"3.8\" fill=\"#1a1a15\" />\n        <circle cx=\"116.8\" cy=\"97.3\" r=\"1.2\" fill=\"#ffffff\" />\n\n        <!-- Smiling mouth -->\n        <path d=\"M102 112 Q 109 120 116 110\" stroke=\"#1a1a15\" stroke-width=\"2.2\" stroke-linecap=\"round\" fill=\"none\"/>\n\n        <!-- Cheek blushes -->\n        <circle cx=\"91\" cy=\"108\" r=\"2.8\" fill=\"#f4a261\" opacity=\"0.65\"/>\n        <circle cx=\"124\" cy=\"104.5\" r=\"2.8\" fill=\"#f4a261\" opacity=\"0.65\"/>\n\n        <!-- Leaf on head -->\n        <path d=\"M116 68 C 119 56 128 52 131 60 C 134 68 122 75 116 68 Z\" fill=\"#689f5c\" stroke=\"#48753e\" stroke-width=\"1.6\"/>\n        <path d=\"M111 70 C 109 63 113 58 118 61\" stroke=\"#48753e\" stroke-width=\"1.6\" fill=\"none\"/>\n      </svg>\n    </div>\n\n    <!-- Prizes Banner: [x 992, y 508, w 292, h 28] -> relative to panel: left 21px, top 442px -->\n    <div class=\"absolute left-[21px] top-[442px] w-[292px] h-[28px] border border-[#1a1a15] rounded-md bg-[#e25335] text-white px-2.5 flex items-center space-x-1.5 text-[9.5px] font-mono-code font-bold shadow-hard-sm z-20\">\n      <svg class=\"w-3.5 h-3.5 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <circle cx=\"12\" cy=\"12\" r=\"9\" />\n        <circle cx=\"12\" cy=\"12\" r=\"3\" />\n      </svg>\n      <span class=\"tracking-tight\">$500 IN PRIZES, LICENSES & DOMAINS</span>\n    </div>\n  </div>\n\n  <!-- 60+ Countries Badge: [x 1359, y 553, w 137, h 27] -->\n  <div class=\"absolute left-[1359px] top-[553px] w-[137px] h-[27px] z-30\">\n    <div class=\"border border-[#1a1a15] rounded-[4px] bg-[#faf5e6] w-full h-full px-2 flex items-cente