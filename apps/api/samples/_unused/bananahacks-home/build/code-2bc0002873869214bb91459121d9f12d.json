ing<br>\n      <span class=\"relative inline-block\">\n        <span class=\"absolute bottom-[2px] left-[-4px] w-[calc(100%+8px)] h-[22px] bg-[#fed832] -z-10\"></span>\n        worth showing off.\n      </span>\n    </h1>\n  </div>\n\n  <!-- Event Description: [x 48, y 284, w 439, h 71] -->\n  <p class=\"absolute left-[48px] top-[284px] w-[439px] h-[71px] text-[13.5px] leading-[1.48] text-[#55534c] font-medium z-20 m-0\">\n    Spend a long weekend building with <strong class=\"text-[#1a1a15] font-bold\">generative AI</strong>. Make an image tool, fine-tune a model, or try an idea that has been sitting in your notes. It's free and fully online.\n  </p>\n\n  <!-- Hacking is live right now: [x 48, y 376, w 240, h 54] -->\n  <div class=\"absolute left-[48px] top-[376px] w-[240px] h-[54px] bg-[#2e593f] text-white text-[13px] font-bold px-4 flex items-center space-x-2.5 rounded-xl border border-[#1a1a15] shadow-hard-sm z-20\">\n    <span class=\"w-2.5 h-2.5 rounded-full bg-[#3cd070] inline-block\"></span>\n    <span>Hacking is live right now</span>\n  </div>\n\n  <!-- Buttons: [x 48, y 446] -->\n  <div class=\"absolute left-[48px] top-[446px] flex items-center space-x-3.5 z-20\">\n    <!-- Register Button: [w 217, h 51] -->\n    <button class=\"w-[217px] h-[51px] bg-[#fed832] border-[1.5px] border-[#1a1a15] rounded-lg font-bold text-[14px] shadow-hard-md cursor-pointer text-[#1a1a15] flex items-center justify-center\">\n      Register now, it's free\n    </button>\n    <!-- Try AI Studio Button: [w 174, h 51] -->\n    <button class=\"w-[174px] h-[51px] bg-[#faf5e6] border-[1.5px] border-[#1a1a15] rounded-lg font-bold text-[14px] shadow-hard-md cursor-pointer text-[#1a1a15] flex items-center justify-center\">\n      Try the AI Studio\n    </button>\n  </div>\n\n  <!-- Backed By Section: [x 46, y 514, w 409, h 46] -->\n  <div class=\"absolute left-[46px] top-[514px] w-[409px] z-20\">\n    <div class=\"text-[9px] font-mono-code font-bold tracking-widest text-[#878579] uppercase mb-1\">\n      BACKED BY\n    </div>\n    <div class=\"flex items-center space-x-[15px] text-[9.5px] font-mono-code font-bold text-[#1a1a15] tracking-wider uppercase\">\n      <span>CODECRAFTERS</span>\n      <span>INTERVIEW CAKE</span>\n      <span>ROSEBUD AI</span>\n      <span>XYZ</span>\n      <span>KARIAA</span>\n    </div>\n    <!-- Down Arrow Icon -->\n    <div class=\"mt-3 text-[#1a1a15]\">\n      <svg class=\"w-4 h-4 text-[#1a1a15]\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path>\n      </svg>\n    </div>\n  </div>\n\n  <!-- Right Column: Illustration Panel [x 971, y 66, w 551, h 539] -->\n  <div class=\"absolute left-[971px] top-[66px] w-[551px] h-[539px] border-[1.5px] border-[#1a1a15] rounded-2xl bg-[#faf5e6] shadow-hard-lg z-10 overflow-hidden\">\n    \n    <!-- Top-left 789 Registered badge inside panel -->\n    <div class=\"absolute left-[18px] top-[18px] border border-[#1a1a15] rounded-[3px] bg-[#fed832] px-2 py-[2.5px] flex items-center space-x-1.5 text-[9.5px] font-mono-code font-bold shadow-hard-sm\">\n      <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" />\n      </svg>\n      <span>789 REGISTERED</span>\n    </div>\n\n    <!-- Top-right Workshops badge with vertical dots -->\n    <div class=\"absolute right-[18px] top-[18px] flex flex-col items-center\">\n      <div class=\"border border-[#1a1a15] rounded-md bg-[#c2e4de] px-2.5 py-[3.5px] flex items-center space-x-1.5 text-[9.5px] font-mono-code font-bold shadow-hard-sm\">\n        <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <polygon points=\"23 7 16 12 23 17 23 7\"></polygon>\n     