lor\"/>\n          <circle cx=\"8\" cy=\"14\" r=\"1\" fill=\"currentColor\"/>\n        </svg>\n      </button>\n\n      <!-- Dock Item 3: Calendar -->\n      <button class=\"w-[42px] h-[44px] rounded-lg border border-[#1a1a15] bg-[#fffdee] flex items-center justify-center hover:bg-white transition-colors\">\n        <svg class=\"w-4 h-4 text-[#1a1a15]\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\">\n          <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/>\n          <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n          <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/>\n          <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n          <circle cx=\"8\" cy=\"14\" r=\"0.8\" fill=\"currentColor\"/>\n          <circle cx=\"12\" cy=\"14\" r=\"0.8\" fill=\"currentColor\"/>\n          <circle cx=\"16\" cy=\"14\" r=\"0.8\" fill=\"currentColor\"/>\n        </svg>\n      </button>\n\n      <!-- Dock Item 4: Sun / Settings -->\n      <button class=\"w-[42px] h-[44px] rounded-lg border border-[#1a1a15] bg-[#fffdee] flex items-center justify-center hover:bg-white transition-colors\">\n        <svg class=\"w-4 h-4 text-[#1a1a15]\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\">\n          <circle cx=\"12\" cy=\"12\" r=\"4\"/>\n          <path d=\"M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"/>\n        </svg>\n      </button>\n\n      <!-- Dock Item 5: Document -->\n      <button class=\"w-[42px] h-[44px] rounded-lg border border-[#1a1a15] bg-[#fffdee] flex items-center justify-center hover:bg-white transition-colors\">\n        <svg class=\"w-4 h-4 text-[#1a1a15]\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\">\n          <path d=\"M14 2H6a2 2